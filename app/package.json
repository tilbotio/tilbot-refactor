{
  "name": "app",
  "version": "2.0.0",
  "description": "Create custom chatbots",
  "author": "Jan de Wit, Tilburg University",
  "private": true,
  "main": "electron-main.ts",
  "type": "module",
  "build": {
    "directories": {
      "buildResources": "_build",
      "output": "../dist"
    },
    "appId": "tilbot",
    "productName": "Tilbot",
    "linux": {
      "category": "Science"
    },
    "icon": "../frontend/src/icon/png/1024x1024.png",
    "extraResources": [
      {
        "from": "../common",
        "to": "common"
      }
    ]
  },
  "scripts": {
    "start": "electron .",
    "package-win": "electron-builder --windows --x64",
    "package-linux": "electron-builder --linux --x64 --dir",
    "package-mac-x64": "electron-builder --mac --x64",
    "package-mac-arm": "electron-builder --mac --arm64"
  },
  "dependencies": {
    "@fastify/static": "^10.1.7",
    "@fastify/websocket": "^11.3.4",
    "adm-zip": "^0.6.1",
    "fastify": "^5.12.7",
    "n-readlines": "^3.4.1",
    "node-fetch": "^3.3.2",
    "public-ip": "^8.0.0",
    "read-excel-file": "^9.3.12",
    "selfsigned": "^5.5.0"
  },
  "devDependencies": {
    "electron": "45.0.0",
    "electron-builder": "26.15.3",
    "tslib": "^2.8.1"
  }
}
